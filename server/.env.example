# Server (Express). Copy to server/.env before `npm start` / `npm run dev`.
# Required. MongoDB connection string (local or Atlas).
MONGO_URI=mongodb://127.0.0.1:27017
# Optional. Database name passed to Mongoose as dbName.
MONGO_DB=token-manager
# Optional. API listen port. Defaults to 8081 when unset.
PORT=8081
