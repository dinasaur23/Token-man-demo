          "$value": { "colorSpace": "srgb", "components": [0.2, 0.1, 0.0], "hex": "#331900" }
        }
      }
    }
  },

  "semantic": {
    "background": {
      "$type": "color",
      "surface": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" } },
      "subtle": {
        "$value": { "colorSpace": "srgb", "components": [0.97, 0.97, 0.97], "hex": "#F7F7F7" }
      },
      "raised": {
        "$value": { "colorSpace": "srgb", "components": [0.94, 0.94, 0.94], "hex": "#F0F0F0" }
      },
      "overlay": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0, 0, 0],
          "alpha": 0.5,
          "hex": "#00000080"
        }
      }
    },
    "text": {
      "$type": "color",
      "default": {
        "$value": { "colorSpace": "srgb", "components": [0.1, 0.1, 0.1], "hex": "#1A1A1A" }
      },
      "muted": {
        "$value": { "colorSpace": "srgb", "components": [0.4, 0.4, 0.4], "hex": "#666666" }
      },
      "soft": {
        "$value": { "colorSpace": "srgb", "components": [0.6, 0.6, 0.6], "hex": "#999999" }
      },
      "on-dark": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" } }
    },
    "status": {
      "$type": "color",

      "success-light": {
        "$value": { "colorSpace": "srgb", "components": [0.8, 1, 0.8], "hex": "#CCFFCC" }
      },
      "success": {
        "$value": { "colorSpace": "srgb", "components": [0.2, 0.7, 0.2], "hex": "#339933" }
      },
      "success-dark": {
        "$value": { "colorSpace": "srgb", "components": [0.1, 0.4, 0.1], "hex": "#1A661A" }
      },

      "warning-light": {
        "$value": { "colorSpace": "srgb", "components": [1, 0.95, 0.8], "hex": "#FFECCC" }
      },
      "warning": {
        "$value": { "colorSpace": "srgb", "components": [1, 0.75, 0.2], "hex": "#FFCC33" }
      },
      "warning-dark": {
        "$value": { "colorSpace": "srgb", "components": [0.6, 0.45, 0.0], "hex": "#996600" }
      },

      "error-light": {
        "$value": { "colorSpace": "srgb", "components": [1, 0.85, 0.85], "hex": "#FFDDDD" }
      },
      "error": {
        "$value": { "colorSpace": "srgb", "components": [1, 0.2, 0.2], "hex": "#FF3333" }
      },
      "error-dark": {
        "$value": { "colorSpace": "srgb", "components": [0.6, 0.0, 0.0], "hex": "#990000" }
      }
    }
  }
}
