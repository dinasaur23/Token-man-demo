{
  "global": {
    "colors": {
      "$type": "color",

      "white": {
        "$value": {
          "colorSpace": "srgb",
          "components": [1, 1, 1],
          "hex": "#ffffff"
        }
      },
      "black": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0, 0, 0],
          "hex": "#000000"
        }
      }
    }
  },

  "brand": {
    "a": {
      "palette": {
        "$type": "color",

        "primary-50": {
          "$value": { "colorSpace": "srgb", "components": [0.95, 0.98, 1], "hex": "#F2F8FF" }
        },
        "primary-100": {
          "$value": { "colorSpace": "srgb", "components": [0.8, 0.9, 1], "hex": "#CCE6FF" }
        },
        "primary-200": {
          "$value": { "colorSpace": "srgb", "components": [0.6, 0.8, 1], "hex": "#99CCFF" }
        },
        "primary-300": {
          "$value": { "colorSpace": "srgb", "components": [0.4, 0.7, 1], "hex": "#66B3FF" }
        },
        "primary-400": {
          "$value": { "colorSpace": "srgb", "components": [0.2, 0.6, 1], "hex": "#3399FF" }
        },
        "primary-500": {
          "$value": { "colorSpace": "srgb", "components": [0.0, 0.5, 1], "hex": "#0080FF" }
        },
        "primary-600": {
          "$value": { "colorSpace": "srgb", "components": [0.0, 0.4, 0.8], "hex": "#0066CC" }
        },
        "primary-700": {
          "$value": { "colorSpace": "srgb", "components": [0.0, 0.3, 0.6], "hex": "#004C99" }
        },
        "primary-800": {
          "$value": { "colorSpace": "srgb", "components": [0.0, 0.2, 0.4], "hex": "#003366" }
        },
        "primary-900": {
          "$value": { "colorSpace": "srgb", "components": [0.0, 0.1, 0.2], "hex": "#001A33" }
        },

        "accent-50": {
          "$value": { "colorSpace": "srgb", "components": [1, 0.95, 0.95], "hex": "#FFECEC" }
        },
        "accent-100": {
          "$value": { "colorSpace": "srgb", "components": [1, 0.8, 0.8], "hex": "#FFCCCC" }
        },
        "accent-200": {
          "$value": { "colorSpace": "srgb", "components": [1, 0.6, 0.6], "hex": "#FF9999" }
        },
        "accent-300": {
          "$value": { "colorSpace": "srgb", "components": [1, 0.4, 0.4], "hex": "#FF6666" }
        },
        "accent-400": {
          "$value": { "colorSpace": "srgb", "components": [1, 0.2, 0.2], "hex": "#FF3333" }
        },
        "accent-500": {
          "$value": { "colorSpace": "srgb", "components": [1, 0.0, 0.0], "hex": "#FF0000" }
        },
        "accent-600": {
          "$value": { "colorSpace": "srgb", "components": [0.8, 0.0, 0.0], "hex": "#CC0000" }
        },
        "accent-700": {
          "$value": { "colorSpace": "srgb", "components": [0.6, 0.0, 0.0], "hex": "#990000" }
        },
        "accent-800": {
          "$value": { "colorSpace": "srgb", "components": [0.4, 0.0, 0.0], "hex": "#660000" }
        },
        "accent-900": {
          "$value": { "colorSpace": "srgb", "components": [0.2, 0.0, 0.0], "hex": "#330000" }
        }
      }
    },

    "b": {
      "palette": {
        "$type": "color",

