          "$value": { "colorSpace": "srgb", "components": [0.96, 1, 0.98], "hex": "#F5FFF9" }
        },
        "primary-100": {
          "$value": { "colorSpace": "srgb", "components": [0.85, 1, 0.9], "hex": "#D9FFE6" }
        },
        "primary-200": {
          "$value": { "colorSpace": "srgb", "components": [0.7, 1, 0.8], "hex": "#B2FFCC" }
        },
        "primary-300": {
          "$value": { "colorSpace": "srgb", "components": [0.5, 1, 0.6], "hex": "#80FF99" }
        },
        "primary-400": {
          "$value": { "colorSpace": "srgb", "components": [0.3, 0.9, 0.4], "hex": "#4CD966" }
        },
        "primary-500": {
          "$value": { "colorSpace": "srgb", "components": [0.2, 0.8, 0.3], "hex": "#33CC4D" }
        },
        "primary-600": {
          "$value": { "colorSpace": "srgb", "components": [0.16, 0.6, 0.22], "hex": "#29993A" }
        },
        "primary-700": {
          "$value": { "colorSpace": "srgb", "components": [0.12, 0.4, 0.16], "hex": "#1F6628" }
        },
        "primary-800": {
          "$value": { "colorSpace": "srgb", "components": [0.08, 0.3, 0.12], "hex": "#144D1F" }
        },
        "primary-900": {
          "$value": { "colorSpace": "srgb", "components": [0.05, 0.2, 0.07], "hex": "#0D3312" }
        }
      }
    },

    "c": {
      "palette": {
        "$type": "color",

        "primary-50": {
          "$value": { "colorSpace": "srgb", "components": [1, 0.97, 0.93], "hex": "#FFF8ED" }
        },
        "primary-100": {
          "$value": { "colorSpace": "srgb", "components": [1, 0.9, 0.8], "hex": "#FFE5CC" }
        },
        "primary-200": {
          "$value": { "colorSpace": "srgb", "components": [1, 0.8, 0.6], "hex": "#FFCC99" }
        },
        "primary-300": {
          "$value": { "colorSpace": "srgb", "components": [1, 0.7, 0.4], "hex": "#FFB366" }
        },
        "primary-400": {
          "$value": { "colorSpace": "srgb", "components": [1, 0.6, 0.2], "hex": "#FF9933" }
        },
        "primary-500": {
          "$value": { "colorSpace": "srgb", "components": [1, 0.5, 0.0], "hex": "#FF8000" }
        },
        "primary-600": {
          "$value": { "colorSpace": "srgb", "components": [0.8, 0.4, 0.0], "hex": "#CC6600" }
        },
        "primary-700": {
          "$value": { "colorSpace": "srgb", "components": [0.6, 0.3, 0.0], "hex": "#994D00" }
        },
        "primary-800": {
          "$value": { "colorSpace": "srgb", "components": [0.4, 0.2, 0.0], "hex": "#663300" }
